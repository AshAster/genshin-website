# Copy to .env and adjust. Every value here is public — Vite inlines anything
# prefixed VITE_ into the client bundle, so never put a secret in this file.
# This is a static site with no backend; there is nothing here worth hiding.

# --- Deployment -------------------------------------------------------------
# Path the site is served from. Leave as "/" for local dev, Netlify, Vercel, or
# a user/org GitHub Pages site. For a GitHub Pages *project* site the repo name
# becomes the path, e.g. "/genshin-website/". Trailing slash required.
VITE_BASE_PATH=/

# Canonical absolute URL, used for og: metadata.
VITE_SITE_URL=https://ashaster.github.io/genshin-website/

# --- Outbound links ---------------------------------------------------------
VITE_OFFICIAL_SITE_URL=https://genshin.hoyoverse.com/en/
VITE_HOYOVERSE_URL=https://www.hoyoverse.com/en-us/

# --- Contact / social -------------------------------------------------------
VITE_CONTACT_EMAIL=ayushpandey1808@gmail.com
VITE_GITHUB_URL=https://www.github.com
VITE_LINKEDIN_URL=https://www.linkedin.com
VITE_TWITTER_URL=https://www.twitter.com
