# Loaded by `npm run deploy` (vite build --mode github). Tracked in git: this is
# deploy configuration, not a secret.
#
# GitHub Pages project sites are served from /<repo>/, so the bundle must be
# built with that base or every asset 404s.
#
# Note: this is a mode file rather than a `--base=/genshin-website/` CLI flag on
# purpose. Git Bash on Windows applies MSYS path conversion to arguments that
# look like POSIX paths, and rewrites that flag into
# "/Program Files/Git/genshin-website/" — silently producing a broken build.
VITE_BASE_PATH=/genshin-website/
VITE_SITE_URL=https://ashaster.github.io/genshin-website/
